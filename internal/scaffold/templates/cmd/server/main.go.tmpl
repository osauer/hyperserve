package main

import (
	"context"
	"log"
	"os"
	"os/signal"
	"syscall"

	"{{ .Module }}/internal/app"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	cfg, err := app.LoadConfig(app.ResolveConfigPath())
	if err != nil {
		log.Fatalf("load config: %v", err)
	}

	appServer, err := app.NewServer(cfg)
	if err != nil {
		log.Fatalf("create server: %v", err)
	}

	if err := app.RegisterMiddleware(appServer, cfg); err != nil {
		log.Fatalf("register middleware: %v", err)
	}
	app.RegisterRoutes(appServer, cfg)

	log.Printf("%s listening on %s", cfg.ServiceName, cfg.Addr)
	if err := appServer.Run(ctx); err != nil {
		log.Fatalf("server exited: %v", err)
	}
}
