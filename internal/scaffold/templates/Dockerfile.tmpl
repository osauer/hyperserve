# syntax=docker/dockerfile:1

# Go 1.27 sets GOMAXPROCS from the cgroup CPU quota automatically, so the
# usual `GOMAXPROCS=$(nproc)` workaround is no longer needed in containers.
FROM golang:1.27 AS builder
WORKDIR /src

COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/{{ .BinaryName }} ./cmd/server

FROM gcr.io/distroless/base-debian12
WORKDIR /
COPY --from=builder /out/{{ .BinaryName }} /usr/local/bin/{{ .BinaryName }}

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/{{ .BinaryName }}"]
