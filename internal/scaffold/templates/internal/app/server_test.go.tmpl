package app

import (
	"net/http"
	"net/http/httptest"
	"testing"
)

func TestGeneratedRoutesUseConfiguredMiddleware(t *testing.T) {
	cfg := DefaultConfig()
	cfg.EnableMCP = false

	srv, err := NewServer(cfg)
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	if err := RegisterMiddleware(srv, cfg); err != nil {
		t.Fatalf("RegisterMiddleware: %v", err)
	}
	RegisterRoutes(srv, cfg)

	for _, path := range []string{"/", "/api/v1/status"} {
		t.Run(path, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, path, nil)
			recorder := httptest.NewRecorder()
			srv.Handler().ServeHTTP(recorder, req)

			if recorder.Code != http.StatusOK {
				t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
			}
			if got := recorder.Header().Get("X-Content-Type-Options"); got != "nosniff" {
				t.Fatalf("X-Content-Type-Options = %q, want nosniff", got)
			}
		})
	}
}

func TestGeneratedAPIRoutesUseRateLimitGate(t *testing.T) {
	cfg := DefaultConfig()
	cfg.EnableMCP = false
	cfg.RateLimit = 1
	cfg.RateBurst = 1

	srv, err := NewServer(cfg)
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	if err := RegisterMiddleware(srv, cfg); err != nil {
		t.Fatalf("RegisterMiddleware: %v", err)
	}
	RegisterRoutes(srv, cfg)

	for attempt, want := range []int{http.StatusOK, http.StatusTooManyRequests} {
		req := httptest.NewRequest(http.MethodGet, "/api/v1/status", nil)
		recorder := httptest.NewRecorder()
		srv.Handler().ServeHTTP(recorder, req)
		if recorder.Code != want {
			t.Fatalf("attempt %d status = %d, want %d", attempt+1, recorder.Code, want)
		}
	}

	req := httptest.NewRequest(http.MethodGet, "/", nil)
	recorder := httptest.NewRecorder()
	srv.Handler().ServeHTTP(recorder, req)
	if recorder.Code != http.StatusOK {
		t.Fatalf("root status = %d, want %d", recorder.Code, http.StatusOK)
	}
}

func TestGeneratedRateLimitConfigMustBeValid(t *testing.T) {
	cfg := DefaultConfig()
	cfg.RateLimit = 0

	srv, err := NewServer(cfg)
	if err != nil {
		t.Fatalf("NewServer: %v", err)
	}
	if err := RegisterMiddleware(srv, cfg); err == nil {
		t.Fatal("RegisterMiddleware accepted a zero request rate")
	}
}
