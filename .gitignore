# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment variables
.env
.env.local
.env.*.local

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# Claude local settings
.claude/

# MCP client metadata
.mcp/

# OS specific files
.DS_Store
Thumbs.db

# Test artifacts
test_static_*
test_templates_*
test_integration_*
*.log
*.tmp
*.test

# Certificates (for examples)
*.pem
*.key
*.crt
*.csr

# Benchmark results
*.prof
cpu.prof
mem.prof
benchmarks/results/
benchmarks/hyperserve-*
benchmarks/*.txt
benchmarks/go-server
benchmarks/performance_test.sh

# Coverage reports
coverage.txt
coverage.html

# Build artifacts
/bin/
/dist/
.gocache/

# Compiled example binaries — keep sources/assets, drop everything else.
# A single allow-list pattern, not a per-example list, so new examples
# don't need a .gitignore edit.
examples/**/*
!examples/**/*.go
!examples/**/*.md
!examples/**/*.html
!examples/**/*.css
!examples/**/*.js
!examples/**/*.json
!examples/**/*.yaml
!examples/**/*.yml
!examples/**/go.mod
!examples/**/go.sum
!examples/**/.gitkeep

# Main binary (repo-root build targets)
/hyperserve
/deferred-init
/cmd/**/cmd/**

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv
